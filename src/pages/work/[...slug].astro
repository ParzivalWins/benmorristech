---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const workEntries = await getCollection('work');
  return workEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} // Case Study // Ben Morris`}
  description={entry.data.tagline}
>
  <article class="max-w-4xl mx-auto">
    <!-- Back to work -->
    <div class="mb-8 font-mono text-xs">
      <a href="/work" class="text-[#8a969f] hover:text-[#ff8a1f] flex items-center gap-1.5 transition-colors">
        <span>←</span>
        <span>BACK TO ALL MISSIONS</span>
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="border-b border-[#253038] pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono mb-4">
        <span class="px-2.5 py-1 bg-[#ff8a1f]/10 text-[#ff8a1f] border border-[#ff8a1f]/30 font-bold">
          {entry.data.client}
        </span>
        <span class="text-[#8a969f]">{entry.data.year}</span>
        <span class="text-[#8a969f]">•</span>
        <span class="text-[#7fe0c8]">{entry.data.role}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono text-[#e0e3e7] leading-tight mb-6">
        {entry.data.title}
      </h1>

      <p class="text-lg text-[#8a969f] font-sans leading-relaxed">
        {entry.data.tagline}
      </p>

      <!-- Key metrics bar -->
      {entry.data.metrics && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 p-4 bg-[#12171b] border border-[#253038] reticle-box font-mono">
          {entry.data.metrics.map(m => (
            <div>
              <div class="text-2xl font-bold text-[#7fe0c8]">{m.value}</div>
              <div class="text-xs text-[#8a969f] mt-0.5">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Tags & Links -->
      <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-[#253038]/60 font-mono text-xs">
        <div class="flex flex-wrap gap-2">
          {entry.data.tags.map(t => (
            <span class="px-2.5 py-1 bg-[#1a2228] text-[#8a969f] border border-[#253038]">
              {t}
            </span>
          ))}
        </div>

        {entry.data.behanceUrl && (
          <a
            href={entry.data.behanceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-[#ff8a1f] text-[#0b0f12] font-bold hover:bg-[#ffb783] transition-colors flex items-center gap-1.5"
          >
            <span>VIEW ON BEHANCE</span>
            <span>↗</span>
          </a>
        )}
      </div>
    </header>

    <!-- Markdown Body -->
    <div class="prose prose-invert prose-orange max-w-none text-[#e0e3e7] font-sans text-base leading-relaxed space-y-6 [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:font-mono [&>h2]:text-[#e0e3e7] [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:pb-2 [&>h2]:border-b [&>h2]:border-[#253038] [&>h3]:text-xl [&>h3]:font-mono [&>h3]:text-[#ff8a1f] [&>h3]:mt-6 [&>h3]:mb-3 [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2 [&>p]:text-[#8a969f] [&>p]:leading-relaxed [&>blockquote]:border-l-2 [&>blockquote]:border-[#ff8a1f] [&>blockquote]:pl-4 [&>blockquote]:italic">
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div class="mt-16 pt-8 border-t border-[#253038] flex justify-between items-center font-mono text-xs">
      <a href="/work" class="text-[#8a969f] hover:text-[#ff8a1f]">
        ← ALL CASE STUDIES
      </a>
      <a href="https://calendly.com/ben100" target="_blank" rel="noopener noreferrer" class="text-[#ff8a1f] hover:underline font-bold">
        DISCUSS THIS MISSION ON CALENDLY ↗
      </a>
    </div>
  </article>
</BaseLayout>
