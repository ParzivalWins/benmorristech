---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Recommendations & Endorsements // Ben Morris"
  description="Executive recommendations, testimonials, and peer endorsements for Ben Morris."
>
  <div class="max-w-4xl mx-auto space-y-12">
    <div class="border-b border-[#253038] pb-8">
      <div class="flex items-center gap-2 text-xs font-mono text-[#8a969f] mb-2">
        <span class="text-[#ff8a1f]">BMX.SYS</span>
        <span>//</span>
        <span class="text-[#e0e3e7]">CREDENTIALS</span>
        <span>•</span>
        <span class="text-[#7fe0c8]">PEER &amp; CLIENT TESTIMONIALS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono text-[#e0e3e7] mb-4">
        Recommendations
      </h1>
      <p class="text-base text-[#8a969f] leading-relaxed">
        Feedback from founders, executive colleagues, and engineering collaborators on high-stakes digital product and commerce initiatives.
      </p>
    </div>

    <!-- Recommendations Grid -->
    <div class="space-y-6">
      <blockquote class="p-6 sm:p-8 bg-[#12171b] border border-[#253038] reticle-box space-y-4">
        <div class="text-sm sm:text-base text-[#e0e3e7] font-sans leading-relaxed italic">
          "Ben is an exceptional product and digital leader who has the rare ability to bridge deep technical architecture with intuitive, elegant customer experience design. He drove monumental results across our digital commerce initiatives, always delivering under tight deadlines."
        </div>
        <div class="flex items-center justify-between text-xs font-mono pt-4 border-t border-[#253038]">
          <div>
            <div class="text-[#ff8a1f] font-bold">Executive Leadership Team</div>
            <div class="text-[#8a969f]">Enterprise Commerce &amp; Retail Innovation</div>
          </div>
          <span class="text-[#7fe0c8] font-bold">VERIFIED</span>
        </div>
      </blockquote>

      <blockquote class="p-6 sm:p-8 bg-[#12171b] border border-[#253038] reticle-box space-y-4">
        <div class="text-sm sm:text-base text-[#e0e3e7] font-sans leading-relaxed italic">
          "Ben's strategic vision on emerging technology and customer engagement loops transformed how we thought about location-based digital interactions. He executes with relentless energy and meticulous attention to detail."
        </div>
        <div class="flex items-center justify-between text-xs font-mono pt-4 border-t border-[#253038]">
          <div>
            <div class="text-[#ff8a1f] font-bold">Digital Products &amp; Emerging Tech Partner</div>
            <div class="text-[#8a969f]">Spatial Computing &amp; Mobile Ecosystems</div>
          </div>
          <span class="text-[#7fe0c8] font-bold">VERIFIED</span>
        </div>
      </blockquote>
    </div>

    <!-- LinkedIn Verification -->
    <div class="p-6 bg-[#0b0f12] border border-[#253038] flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <div class="text-[#8a969f]">
        Want to read additional detailed recommendations and endorsements?
      </div>
      <a
        href="https://www.linkedin.com/in/benmorristech"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 bg-[#ff8a1f] text-[#0b0f12] font-bold hover:bg-[#ffb783] transition-colors whitespace-nowrap"
      >
        VIEW LINKEDIN PROFILE ↗
      </a>
    </div>
  </div>
</BaseLayout>
