---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);
const featuredWork = sortedWork.slice(0, 4);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---

<BaseLayout
  title="Ben Morris // Product Leader, CX Strategist & Builder"
  description="Executive Product Leader and CX Strategist. Scaled digital commerce for GoalZero, Smith Optics, Westfield AR, and Human Improvement."
>
  <!-- Hero Section -->
  <section class="mb-16 pt-4 md:pt-8 border-b border-[#253038] pb-12">
    <!-- Telemetry status row -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[#8a969f] mb-6">
      <div class="flex items-center gap-2">
        <span class="text-[#ff8a1f]">BMX.v2</span>
        <span>//</span>
        <span class="text-[#e0e3e7]">LOS ANGELES, CA</span>
        <span>•</span>
        <span class="text-[#7fe0c8]">READY FOR IMPACT</span>
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span>EDGE HOST: <strong class="text-[#e0e3e7]">CLOUDFLARE</strong></span>
        <span>LATENCY: <strong class="text-[#7fe0c8]">&lt;20ms</strong></span>
      </div>
    </div>

    <!-- Main Headline -->
    <div class="space-y-4 max-w-4xl">
      <div class="inline-block px-2.5 py-0.5 text-[11px] font-mono font-bold tracking-wider uppercase bg-[#ff8a1f]/10 text-[#ff8a1f] border border-[#ff8a1f]/30">
        Executive Product Leadership & Experience Architecture
      </div>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold font-mono tracking-tight text-[#e0e3e7] leading-tight">
        Potential to Kinetic Energy.
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-[#8a969f] font-sans leading-relaxed max-w-3xl">
        I lead cross-functional product, design, and engineering teams to transform complex friction into high-performing digital commerce, spatial computing, and mobile ecosystems.
      </p>
    </div>

    <!-- Key Metrics Ribbon -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10 font-mono">
      <div class="p-4 bg-[#12171b] border border-[#253038] reticle-box">
        <div class="text-2xl sm:text-3xl font-bold text-[#ff8a1f]">+48%</div>
        <div class="text-xs text-[#8a969f] mt-1">Checkout Conversion Lift (GoalZero)</div>
      </div>
      <div class="p-4 bg-[#12171b] border border-[#253038] reticle-box">
        <div class="text-2xl sm:text-3xl font-bold text-[#7fe0c8]">10M+</div>
        <div class="text-xs text-[#8a969f] mt-1">Spatial AR Footfall (Westfield)</div>
      </div>
      <div class="p-4 bg-[#12171b] border border-[#253038] reticle-box">
        <div class="text-2xl sm:text-3xl font-bold text-[#e0e3e7]">1.5M+</div>
        <div class="text-xs text-[#8a969f] mt-1">Active Mobile Installs &amp; 4.7★</div>
      </div>
      <div class="p-4 bg-[#12171b] border border-[#253038] reticle-box">
        <div class="text-2xl sm:text-3xl font-bold text-[#ffd400]">$25M+</div>
        <div class="text-xs text-[#8a969f] mt-1">Scaled Enterprise GMV</div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center gap-4 mt-8 font-mono text-xs">
      <a
        href="/work"
        class="px-5 py-2.5 bg-[#ff8a1f] text-[#0b0f12] font-bold hover:bg-[#ffb783] transition-colors flex items-center gap-2"
      >
        <span>EXPLORE PORTFOLIO &amp; CASE STUDIES</span>
        <span>→</span>
      </a>
      <a
        href="https://www.behance.net/benmorris"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2.5 bg-[#12171b] border border-[#253038] text-[#e0e3e7] hover:border-[#ff8a1f] hover:text-[#ff8a1f] transition-all flex items-center gap-1.5"
      >
        <span>BEHANCE PORTFOLIO</span>
        <span>↗</span>
      </a>
      <a
        href="https://calendly.com/ben100"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2.5 bg-[#12171b] border border-[#253038] text-[#7fe0c8] hover:border-[#7fe0c8] transition-all flex items-center gap-1.5"
      >
        <span>SCHEDULE 30-MIN INTRO</span>
        <span>↗</span>
      </a>
    </div>
  </section>

  <!-- Featured Work Bento Grid -->
  <section class="mb-20">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-[#253038]">
      <div class="flex items-center gap-3">
        <span class="text-xs font-mono text-[#ff8a1f] font-bold">[01 // MISSION LOG]</span>
        <h2 class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-[#e0e3e7]">
          FLAGSHIP CASE STUDIES
        </h2>
      </div>
      <a href="/work" class="text-xs font-mono text-[#8a969f] hover:text-[#ff8a1f] flex items-center gap-1">
        <span>VIEW ALL MISSIONS</span>
        <span>→</span>
      </a>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredWork.map((project, idx) => (
        <article class="p-6 bg-[#12171b] border border-[#253038] hover:border-[#ff8a1f] transition-all group flex flex-col justify-between reticle-box">
          <div>
            <!-- Header Tag row -->
            <div class="flex items-center justify-between text-xs font-mono text-[#8a969f] mb-3">
              <span class="text-[#ff8a1f] font-bold">{project.data.client}</span>
              <span class="text-[11px] px-2 py-0.5 bg-[#0b0f12] border border-[#253038]">{project.data.year}</span>
            </div>

            <!-- Title -->
            <h3 class="text-lg sm:text-xl font-bold font-mono text-[#e0e3e7] group-hover:text-[#ff8a1f] transition-colors mb-2">
              <a href={`/work/${project.id}`} class="focus:outline-none">
                {project.data.title}
              </a>
            </h3>

            <!-- Tagline -->
            <p class="text-sm text-[#8a969f] font-sans leading-relaxed mb-6">
              {project.data.tagline}
            </p>

            <!-- Metrics Preview -->
            {project.data.metrics && (
              <div class="grid grid-cols-3 gap-2 py-3 px-3 mb-6 bg-[#0b0f12] border border-[#253038]/60 font-mono text-xs">
                {project.data.metrics.map(m => (
                  <div>
                    <div class="text-[#7fe0c8] font-bold text-sm">{m.value}</div>
                    <div class="text-[10px] text-[#8a969f] truncate">{m.label}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Bottom bar: Tags + Action -->
          <div>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.data.tags.slice(0, 3).map(tag => (
                <span class="text-[10px] font-mono px-2 py-0.5 bg-[#1a2228] text-[#8a969f] border border-[#253038]">
                  {tag}
                </span>
              ))}
            </div>

            <div class="pt-4 border-t border-[#253038]/80 flex items-center justify-between text-xs font-mono">
              <span class="text-[#8a969f]">{project.data.role}</span>
              <a href={`/work/${project.id}`} class="text-[#ff8a1f] group-hover:translate-x-1 transition-transform flex items-center gap-1 font-semibold">
                <span>READ STUDY</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Recent Field Notes & Writing -->
  <section class="mb-20">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-[#253038]">
      <div class="flex items-center gap-3">
        <span class="text-xs font-mono text-[#ff8a1f] font-bold">[02 // FIELD NOTES]</span>
        <h2 class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-[#e0e3e7]">
          RECENT WRITING &amp; INSIGHTS
        </h2>
      </div>
      <a href="/blog" class="text-xs font-mono text-[#8a969f] hover:text-[#ff8a1f] flex items-center gap-1">
        <span>VIEW 180+ ARTICLES</span>
        <span>→</span>
      </a>
    </div>

    <div class="divide-y divide-[#253038] border-y border-[#253038] bg-[#12171b]">
      {recentPosts.map(post => (
        <article class="p-5 sm:p-6 hover:bg-[#1a2228]/50 transition-colors flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5 flex-1">
            <div class="flex items-center gap-2 text-xs font-mono text-[#8a969f]">
              <span class="text-[#ff8a1f]">{post.data.date}</span>
              {post.data.categories.length > 0 && (
                <>
                  <span>•</span>
                  <span class="text-[#7fe0c8]">{post.data.categories[0]}</span>
                </>
              )}
            </div>
            <h3 class="text-base sm:text-lg font-bold font-mono text-[#e0e3e7] hover:text-[#ff8a1f] transition-colors">
              <a href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h3>
            {post.data.excerpt && (
              <p class="text-xs sm:text-sm text-[#8a969f] font-sans line-clamp-2 max-w-3xl">
                {post.data.excerpt}
              </p>
            )}
          </div>
          <a
            href={`/blog/${post.id}`}
            class="text-xs font-mono text-[#ff8a1f] hover:text-[#ffb783] whitespace-nowrap self-start md:self-center flex items-center gap-1"
          >
            <span>READ NOTE</span>
            <span>→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- Connect / Schedule Section -->
  <section class="p-8 sm:p-12 bg-[#12171b] border border-[#253038] reticle-box font-mono">
    <div class="max-w-2xl">
      <div class="text-xs text-[#7fe0c8] font-bold mb-2">// DIRECT ENGAGEMENT</div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#e0e3e7] mb-4">
        Ready to build what's next?
      </h2>
      <p class="text-sm text-[#8a969f] font-sans leading-relaxed mb-8">
        Whether you are evaluating executive product leadership, scaling direct-to-consumer commerce, or architecting spatial &amp; emerging technologies, let's connect.
      </p>
      <div class="flex flex-wrap gap-4 text-xs font-bold">
        <a
          href="https://calendly.com/ben100"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-[#ff8a1f] text-[#0b0f12] hover:bg-[#ffb783] transition-colors"
        >
          SCHEDULE TIME ON CALENDLY ↗
        </a>
        <a
          href="https://www.linkedin.com/in/benmorristech"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-[#1a2228] border border-[#253038] text-[#e0e3e7] hover:border-[#ff8a1f] hover:text-[#ff8a1f] transition-all"
        >
          CONNECT ON LINKEDIN ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
